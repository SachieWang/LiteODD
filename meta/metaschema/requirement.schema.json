{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Requirement",
  "type": "object",
  "required": ["requirement"],
  "properties": {
    "requirement": {
      "type": "object",
      "required": ["id", "title", "source", "conceptRef", "meta"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "source": { "type": "string" },
        "conceptRef": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "type": { "enum": ["functional", "quality", "constraint"] },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "meta": {
          "type": "object",
          "required": ["schemaVersion"],
          "properties": {
            "schemaVersion": { "type": "string" }
          }
        }
      }
    }
  }
}
