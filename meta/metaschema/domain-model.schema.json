{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Domain Model",
  "type": "object",
  "required": ["domainModel"],
  "properties": {
    "domainModel": {
      "type": "object",
      "required": ["id", "conceptRef", "meta"],
      "properties": {
        "id": { "type": "string" },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "conceptRef"],
            "properties": {
              "name": { "type": "string" },
              "conceptRef": { "type": "string" },
              "attributes": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "boundedContexts": { "type": "array", "items": { "type": "string" } },
        "relationships": { "type": "array", "items": { "type": "object" } },
        "invariants": { "type": "array", "items": { "type": "string" } },
        "conceptRef": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "meta": {
          "type": "object",
          "required": ["schemaVersion"],
          "properties": {
            "schemaVersion": { "type": "string" }
          }
        }
      }
    }
  }
}
