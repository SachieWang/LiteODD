{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architecture Assessment Report",
  "type": "object",
  "required": ["report"],
  "properties": {
    "report": {
      "type": "object",
      "required": ["id", "targetRef", "conceptRef", "meta"],
      "properties": {
        "id": { "type": "string" },
        "targetRef": { "type": "string" },
        "qualityAttributes": { "type": "array", "items": { "type": "string" } },
        "views": { "type": "array", "items": { "type": "string" } },
        "assessments": {
          "type": "array",
          "items": { "type": "object" }
        },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "conceptRef": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "meta": {
          "type": "object",
          "required": ["schemaVersion"],
          "properties": {
            "schemaVersion": { "type": "string" }
          }
        }
      }
    }
  }
}
